# Copy to .env.local for local development against Neon, and set the same
# values in Vercel → Project → Settings → Environment Variables.

# Neon → your project → Connection string (pooled)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random secret: run `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email for sign-in links and invites (a Gmail app password works):
# smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_SERVER=
EMAIL_FROM="F1 Underground <you@gmail.com>"

# Comma-separated: these emails become commissioners on first sign-in.
BOOTSTRAP_COMMISSIONER_EMAILS=you@gmail.com
