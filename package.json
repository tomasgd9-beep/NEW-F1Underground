{
  "name": "f1-underground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && tsx scripts/backfill.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local": "tsx scripts/local-db.ts",
    "dev:local": "cross-env DATABASE_URL=pglite:./.pglite AUTH_SECRET=local-dev-secret AUTH_TRUST_HOST=true next dev",
    "job": "tsx scripts/job.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource/titillium-web": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
